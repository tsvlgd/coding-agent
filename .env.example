# Copy to `.env` and fill in. `.env` is gitignored.
# Load it into your shell (or prefix the command):
#   set -a && source .env && set +a
#   uv run agent

# Required. Any OpenAI-compatible provider key.
API_KEY=

# Optional. Base URL of the OpenAI-compatible endpoint (e.g., https://api.groq.com/openai/v1).
# Leave empty or unset to use the official OpenAI default endpoint.
BASE_URL=